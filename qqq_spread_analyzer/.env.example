# IB Gateway / TWS connection (read-only research — no orders)
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=12
IB_READ_ONLY=true
IB_MARKET_DATA_TYPE=1

# Bar timeframe for intraday timing: 2h or 4h
BAR_TIMEFRAME=2h

# Spread selection
MIN_DTE=21
MAX_DTE=45
MAX_OPTION_SPREAD_PCT=0.15
MIN_OPEN_INTEREST=500
MIN_VOLUME=100

# DuckDB cache path (relative to qqq_spread_analyzer/)
DB_PATH=data/qqq_analyzer.duckdb
