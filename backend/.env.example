# =============================================================================
# Billion Dollar Backend — Environment Variables
# Copy to backend/.env (never commit real secrets)
# =============================================================================

# --- QQQ Spread Analyzer (API subprocess) ---
# Override analyzer JSON output directory (default: ../qqq_spread_analyzer/data)
QQQ_ANALYZER_DATA_DIR=
# Path to Poetry binary used when API spawns analyzer runs
QQQ_ANALYZER_POETRY=/opt/homebrew/bin/poetry

# --- News Intelligence / Market Intelligence Center ---
# Finnhub API key — market + company news (https://finnhub.io)
FINNHUB_API_KEY="d3q90e9r01qgab53ms6gd3q90e9r01qgab53ms70"
# Alpha Vantage API key — news sentiment (optional; pipeline skips if empty)
ALPHA_VANTAGE_API_KEY="OSTEQWKUM3CKKEMT"

# SEC EDGAR User-Agent — required format: "AppName your-email@example.com"
SEC_USER_AGENT="BillionDollarApp ankeit.taksh@gmail.com"
# API budget display limits (used by ApiBudgetManager on MIC page)
FINNHUB_DAILY_LIMIT=1000
ALPHA_VANTAGE_DAILY_LIMIT=25
SEC_DAILY_LIMIT=10000

# --- Paper Trading IBKR sync (separate from analyzer client ID 12) ---
# tws_client_id and tws_port are set in backend/config.yaml (default: 13, 4001)
